# MongoDB Atlas connection string. Required on Vercel.
# Local `npm run dev` uses an embedded database when this is unset.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/seventy_two?retryWrites=true&w=majority

# Public site URL used in text links. Set this to the Vercel URL after the first deploy.
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Required on Vercel. Vercel sends this as Authorization: Bearer ... for the daily text cron.
# CRON_SECRET=generate-a-long-random-string

# Telegram (recommended for demos). When TELEGRAM_BOT_TOKEN is set, reminders use Telegram instead of SMS.
# 1. Message @BotFather on Telegram, create a bot, copy the token.
# 2. Set TELEGRAM_BOT_USERNAME to the bot handle without @ (optional; fetched from Telegram if omitted).
# 3. Local `npm run dev` polls Telegram automatically (no webhook). On Vercel, add TELEGRAM_* here too; webhook is used there.
# TELEGRAM_USE_POLLING=0  # keep Vercel webhook while running locally (same bot — usually use one environment at a time)
#    with the same secret as TELEGRAM_WEBHOOK_SECRET (or CRON_SECRET).
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...
# TELEGRAM_BOT_USERNAME=YourInReachBot
# TELEGRAM_DEMO_CHAT_ID=123456789  # optional: all demo reminders go here (or message the bot once with /start)
# TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# Twilio SMS (only used when TELEGRAM_BOT_TOKEN is unset). Fictional 555-01xx demo numbers are skipped.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+1XXXXXXXXXX

# Stripe. When STRIPE_SECRET_KEY is set, the invoice page uses real Stripe Checkout (test mode with sk_test_...).
# STRIPE_SECRET_KEY=<your-stripe-test-secret-key>

# Reads the discharge PDF into medications, therapy, and equipment. Without it, a built-in reader is used.
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-5-5
