# MongoDB Atlas connection string. Required on Vercel.
# Local `npm run dev` uses an embedded database when this is unset.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/seventy_two?retryWrites=true&w=majority

# Public site URL used in text links. Set this to the Vercel URL after the first deploy.
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Required on Vercel. Vercel sends this as Authorization: Bearer ... for the daily text cron.
# CRON_SECRET=generate-a-long-random-string

# Twilio SMS. When set, real texts are sent to the caregiver and patient (fictional 555-01xx demo numbers are skipped).
# A trial account can only text verified numbers, and it rejects custom medication questions until the account is upgraded.
# Do not put the Twilio sending number in the caregiver or patient phone field.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+1XXXXXXXXXX
# Optional alternative to TWILIO_FROM:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe. When STRIPE_SECRET_KEY is set, the invoice page uses real Stripe Checkout (test mode with sk_test_...).
# STRIPE_SECRET_KEY=<your-stripe-test-secret-key>

# Reads the discharge PDF into medications, therapy, and equipment. Without it, a built-in reader is used.
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-5-5
